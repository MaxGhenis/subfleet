#!/usr/bin/env bash
# codex PATH shim — automatic subfleet lane selection for headless commands.
#
# Interactive commands, explicit CODEX_HOME values, and callers setting
# SUBFLEET_NO_AUTOPICK pass through unchanged, with one exception: a headless
# command whose CODEX_HOME is an OpenAI API-key login (metered platform
# billing) is refused with rc 7 unless SUBFLEET_ALLOW_API_LANE=1, because
# lanes run on ChatGPT subscriptions only.
set -uo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SUBFLEET=${SUBFLEET_SHIM_SUBFLEET:-$SCRIPT_DIR/subfleet}

if [ -n "${SUBFLEET_CODEX_BIN:-}" ]; then
  REAL=$SUBFLEET_CODEX_BIN
else
  REAL=$("$SUBFLEET" _codex-binary 2>/dev/null) || REAL=""
fi
if [ -z "$REAL" ] || [ "$REAL" = "$0" ]; then
  echo "codex-shim: real codex binary not found" >&2
  exit 127
fi

case "${1:-}" in
  exec|e|review)
    if [ -z "${CODEX_HOME:-}" ] && [ -z "${SUBFLEET_NO_AUTOPICK:-}" ]; then
      if ! pick=$("$SUBFLEET" pick codex 2>/dev/null); then
        echo "codex-shim: no dispatchable Codex lane; refusing to use the desktop app home" >&2
        exit 1
      fi
      if [ -z "$pick" ] || [ ! -d "$pick" ]; then
        echo "codex-shim: picker returned no usable lane; refusing to use the desktop app home" >&2
        exit 1
      fi
      export CODEX_HOME="$pick"
      echo "codex-shim: CODEX_HOME unset -> $pick (set CODEX_HOME or SUBFLEET_NO_AUTOPICK=1 to opt out)" >&2
    fi
    # Subscription only: a CODEX_HOME that is an OpenAI API-key login is
    # refused (rc 7) unless SUBFLEET_ALLOW_API_LANE=1.
    if [ "${SUBFLEET_ALLOW_API_LANE:-}" != "1" ] && [ -n "${CODEX_HOME:-}" ] && [ -x "$SUBFLEET" ]; then
      "$SUBFLEET" _api-lane-check "$CODEX_HOME" || exit 7
    fi
    ;;
esac

exec "$REAL" "$@"
